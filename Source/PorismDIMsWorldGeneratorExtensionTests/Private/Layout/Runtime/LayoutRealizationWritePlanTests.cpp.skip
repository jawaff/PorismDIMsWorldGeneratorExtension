IMPLEMENT_SIMPLE_AUTOMATION_TEST(
	FLayoutRealizationWritePlanRejectsUnsupportedRampTransitionContractTest,
	"PorismExtension.Layout.Runtime.RealizationWritePlan.RejectsUnsupportedRampTransitionContract",
	EAutomationTestFlags::EditorContext | EAutomationTestFlags::EngineFilter)

bool FLayoutRealizationWritePlanRejectsUnsupportedRampTransitionContractTest::RunTest(const FString& Parameters)
{
	const FLayoutSolveResult SolveResult = BuildSuccessfulWritePlanSolveResult();
	FLayoutFrozenTerrainContract FrozenTerrainContract = BuildWritePlanFrozenTerrainContract();
	FrozenTerrainContract.CellContracts[1].bHasRampTransitionEvidence = true;

	FLayoutRealizationWritePlan WritePlan;
	FString FailureReason;
	TestFalse(
		TEXT("Write plan rejects ramp-transition evidence on non-active terrain contracts"),
		LayoutRealizationWritePlan::TryBuildFromAcceptedSolveInputs(
			ELayoutRealizationWritePlanSource::Site,
			TEXT("SolvedArtifact.Site.InvalidRampTransition"),
			SolveResult.Placements.Num(),
			FrozenTerrainContract.ActiveCells.Num(),
			SolveResult,
			FrozenTerrainContract,
			WritePlan,
			FailureReason));
	TestTrue(TEXT("Invalid ramp-transition contract failure reported"), FailureReason.Contains(TEXT("ramp-transition evidence")));
	return true;
}

IMPLEMENT_SIMPLE_AUTOMATION_TEST(
	FLayoutRealizationWritePlanRejectsInvalidChunkWriteBatchOrderTest,
	"PorismExtension.Layout.Runtime.RealizationWritePlan.RejectsInvalidChunkWriteBatchOrder",
	EAutomationTestFlags::EditorContext | EAutomationTestFlags::EngineFilter)

bool FLayoutRealizationWritePlanRejectsInvalidChunkWriteBatchOrderTest::RunTest(const FString& Parameters)
{
	const FLayoutSolveResult SolveResult = BuildSuccessfulWritePlanSolveResult();
	const FLayoutFrozenTerrainContract FrozenTerrainContract = BuildWritePlanFrozenTerrainContract();

	FLayoutRealizationWritePlan WritePlan;
	FString FailureReason;
	TestTrue(
		TEXT("Write plan builds before chunk write-batch validation"),
		LayoutRealizationWritePlan::TryBuildFromAcceptedSolveInputs(
			ELayoutRealizationWritePlanSource::Site,
			TEXT("SolvedArtifact.Site.ChunkWriteBatch"),
			SolveResult.Placements.Num(),
			FrozenTerrainContract.ActiveCells.Num(),
			SolveResult,
			FrozenTerrainContract,
			WritePlan,
			FailureReason));

	Swap(WritePlan.ChunkWriteBatch.PassOrder[0], WritePlan.ChunkWriteBatch.PassOrder[2]);
	TestFalse(
		TEXT("Terrain replay rejects invalid chunk write-batch pass order before chunk writes"),
		LayoutRealizationWritePlan::ValidateTerrainWriteReplayForTests(
			WritePlan,
			FrozenTerrainContract,
			FailureReason));
	TestTrue(TEXT("Invalid pass order failure reported"), FailureReason.Contains(TEXT("pass order")));
	return true;
}

IMPLEMENT_SIMPLE_AUTOMATION_TEST(
	FLayoutRealizationWritePlanApplyRejectsStaleTerrainReplayBeforeChunkWritesTest,
	"PorismExtension.Layout.Runtime.RealizationWritePlan.ApplyRejectsStaleTerrainReplayBeforeChunkWrites",
	EAutomationTestFlags::EditorContext | EAutomationTestFlags::EngineFilter)

bool FLayoutRealizationWritePlanApplyRejectsStaleTerrainReplayBeforeChunkWritesTest::RunTest(const FString& Parameters)
{
	const FLayoutSolveResult SolveResult = BuildSuccessfulWritePlanSolveResult();
	FLayoutFrozenTerrainContract FrozenTerrainContract = BuildWritePlanFrozenTerrainContract();

	FLayoutRealizationWritePlan WritePlan;
	FString FailureReason;
	TestTrue(
		TEXT("Write plan builds before apply replay validation"),
		LayoutRealizationWritePlan::TryBuildFromAcceptedSolveInputs(
			ELayoutRealizationWritePlanSource::Connector,
			TEXT("SolvedArtifact.Connector.ApplyTerrainReplay"),
			SolveResult.Placements.Num(),
			FrozenTerrainContract.ActiveCells.Num(),
			SolveResult,
			FrozenTerrainContract,
			WritePlan,
			FailureReason));

	FrozenTerrainContract.TerrainWrites.Pop();
	FLayoutRealizationWritePlanExecutionState ExecutionState;
	TestFalse(
		TEXT("ApplyTerrainWriteReplay rejects stale terrain replay before low-level chunk writes"),
		LayoutRealizationWritePlan::ApplyTerrainWriteReplay(
			nullptr,
			WritePlan,
			FrozenTerrainContract,
			ExecutionState,
			FailureReason));
	TestFalse(TEXT("Failed terrain replay leaves execution state incomplete"), ExecutionState.bTerrainReplayApplied);
	TestTrue(TEXT("Stale replay failure is reported before chunk-world failure"), FailureReason.Contains(TEXT("stale terrain write-plan counts")));
	return true;
}

