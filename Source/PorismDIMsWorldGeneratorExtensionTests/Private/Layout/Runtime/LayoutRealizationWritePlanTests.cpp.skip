IMPLEMENT_SIMPLE_AUTOMATION_TEST(
	FLayoutRealizationWritePlanTemplateWriteRequiresTerrainPassTest,
	"PorismExtension.Layout.Runtime.RealizationWritePlan.TemplateWriteRequiresTerrainPass",
	EAutomationTestFlags::EditorContext | EAutomationTestFlags::EngineFilter)

bool FLayoutRealizationWritePlanTemplateWriteRequiresTerrainPassTest::RunTest(const FString& Parameters)
{
	const FLayoutSolveResult SolveResult = BuildSuccessfulWritePlanSolveResult();
	const FLayoutFrozenTerrainContract FrozenTerrainContract = BuildWritePlanFrozenTerrainContract();

	FLayoutRealizationWritePlan WritePlan;
	FString FailureReason;
	TestTrue(
		TEXT("Write plan builds before template execution-state validation"),
		LayoutRealizationWritePlan::TryBuildFromAcceptedSolveInputs(
			ELayoutRealizationWritePlanSource::Site,
			TEXT("SolvedArtifact.Site.TemplateExecutionState"),
			SolveResult.Placements.Num(),
			FrozenTerrainContract.ActiveCells.Num(),
			SolveResult,
			FrozenTerrainContract,
			WritePlan,
			FailureReason));

	FLayoutRealizationWritePlanExecutionState ExecutionState;
	TestFalse(
		TEXT("Template write rejects before terrain write-batch passes complete"),
		LayoutRealizationWritePlan::ValidateTemplatePlacementWrite(
			WritePlan,
			SolveResult.Placements[0],
			ExecutionState,
			FailureReason));
	TestTrue(TEXT("Missing terrain pass failure reported"), FailureReason.Contains(TEXT("terrain write-batch passes")));

	ExecutionState.bTerrainReplayApplied = true;
	TestTrue(
		TEXT("Template write accepts after terrain write-batch pass completes"),
		LayoutRealizationWritePlan::ValidateTemplatePlacementWrite(
			WritePlan,
			SolveResult.Placements[0],
			ExecutionState,
			FailureReason));
	return true;
}

