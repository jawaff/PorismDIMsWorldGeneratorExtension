#include "../../../../PorismDIMsWorldGeneratorExtension/Private/Layout/Runtime/LayoutRealizationWritePlan.h"

#include "Misc/AutomationTest.h"

namespace
{
	FLayoutSolveResult BuildSuccessfulWritePlanSolveResult()
	{
		FLayoutSolveResult SolveResult;
		SolveResult.bSucceeded = true;
		SolveResult.SharedCellSizeInBlocks = FIntVector(16, 16, 16);
		SolveResult.FootprintSize = FIntPoint(2);

		FLayoutPlacedModule Placement;
		Placement.Cell = FIntVector::ZeroValue;
		Placement.SourceContentEntryId = TEXT("Content.Entry.0");
		Placement.ModuleSnapshotId = TEXT("Module.Snapshot.0");
		Placement.TemplatePath = FSoftObjectPath(TEXT("/Game/Test/Templates/T_Module.T_Module"));
		SolveResult.Placements.Add(Placement);
		return SolveResult;
	}

	TArray<FLayoutContractActiveCellRecord> BuildWritePlanActiveCells()
	{
		TArray<FLayoutContractActiveCellRecord> ActiveCells;

		FLayoutContractActiveCellRecord RealCell;
		RealCell.Cell = FIntVector::ZeroValue;
		RealCell.CellKind = ELayoutContractActiveCellKind::Real;
		ActiveCells.Add(RealCell);

		FLayoutContractActiveCellRecord SecondaryRealCell;
		SecondaryRealCell.Cell = FIntVector(1, 0, 0);
		SecondaryRealCell.CellKind = ELayoutContractActiveCellKind::Real;
		ActiveCells.Add(SecondaryRealCell);

		return ActiveCells;
	}

	FLayoutFrozenTerrainContract BuildWritePlanFrozenTerrainContract()
	{
		FLayoutFrozenTerrainContract Contract;
		Contract.ContractId = TEXT("FrozenTerrain.WritePlan.0");
		Contract.SharedCellSizeInBlocks = FIntVector(16, 16, 16);
		Contract.FootprintSizeInCells = FIntPoint(2);

		FLayoutContractActiveCellRecord RealCell;
		RealCell.Cell = FIntVector::ZeroValue;
		RealCell.CellKind = ELayoutContractActiveCellKind::Real;
		Contract.ActiveCells.Add(RealCell);

		FLayoutContractActiveCellRecord ClearanceRealCell;
		ClearanceRealCell.Cell = FIntVector(1, 0, 0);
		ClearanceRealCell.CellKind = ELayoutContractActiveCellKind::Real;
		Contract.ActiveCells.Add(ClearanceRealCell);

		FLayoutContractActiveCellRecord BridgeRealCell;
		BridgeRealCell.Cell = FIntVector(2, 0, 0);
		BridgeRealCell.CellKind = ELayoutContractActiveCellKind::Real;
		Contract.ActiveCells.Add(BridgeRealCell);

		FLayoutContractActiveCellRecord RampRealCell;
		RampRealCell.Cell = FIntVector(3, 0, 0);
		RampRealCell.CellKind = ELayoutContractActiveCellKind::Real;
		Contract.ActiveCells.Add(RampRealCell);

		FLayoutContractActiveCellRecord ExcavationRealCell;
		ExcavationRealCell.Cell = FIntVector(4, 0, 0);
		ExcavationRealCell.CellKind = ELayoutContractActiveCellKind::Real;
		Contract.ActiveCells.Add(ExcavationRealCell);

		FLayoutTerrainCellContractRecord CellContract;
		CellContract.Cell = FIntVector::ZeroValue;
		CellContract.Contract = ELayoutFrozenTerrainCellContract::Active;
		CellContract.bHasFoundationFillEvidence = true;
		Contract.CellContracts.Add(CellContract);

		FLayoutTerrainCellContractRecord ClearanceCellContract;
		ClearanceCellContract.Cell = FIntVector(1, 0, 0);
		ClearanceCellContract.Contract = ELayoutFrozenTerrainCellContract::FlatClearance;
		ClearanceCellContract.bHasClearanceEvidence = true;
		Contract.CellContracts.Add(ClearanceCellContract);

		FLayoutTerrainCellContractRecord BridgeCellContract;
		BridgeCellContract.Cell = FIntVector(2, 0, 0);
		BridgeCellContract.Contract = ELayoutFrozenTerrainCellContract::BridgeSpan;
		BridgeCellContract.bHasBridgeSupportEvidence = true;
		Contract.CellContracts.Add(BridgeCellContract);

		FLayoutTerrainCellContractRecord ExcavationCellContract;
		ExcavationCellContract.Cell = FIntVector(4, 0, 0);
		ExcavationCellContract.Contract = ELayoutFrozenTerrainCellContract::TunnelExcavation;
		ExcavationCellContract.bHasExcavationOverlapZ = true;
		LayoutLocalBlockCoordinates::TryMakeCoord8(1, ExcavationCellContract.ExcavationOverlapMinLocalZ);
		LayoutLocalBlockCoordinates::TryMakeCoord8(4, ExcavationCellContract.ExcavationOverlapMaxLocalZ);
		Contract.CellContracts.Add(ExcavationCellContract);

		FLayoutTerrainCellContractRecord RampCellContract;
		RampCellContract.Cell = FIntVector(3, 0, 0);
		RampCellContract.Contract = ELayoutFrozenTerrainCellContract::Active;
		RampCellContract.bHasRampTransitionEvidence = true;
		Contract.CellContracts.Add(RampCellContract);

		FLayoutFrozenTerrainWriteRecord TerrainWrite;
		TerrainWrite.BlockWorldPos = FIntVector(16, 16, 16);
		TerrainWrite.SourceContract = ELayoutFrozenTerrainCellContract::Active;
		Contract.TerrainWrites.Add(TerrainWrite);

		FLayoutFrozenTerrainWriteRecord ClearanceWrite;
		ClearanceWrite.BlockWorldPos = FIntVector(32, 16, 16);
		ClearanceWrite.SourceContract = ELayoutFrozenTerrainCellContract::FlatClearance;
		Contract.TerrainWrites.Add(ClearanceWrite);

		FLayoutFrozenTerrainWriteRecord BridgeWrite;
		BridgeWrite.BlockWorldPos = FIntVector(48, 16, 16);
		BridgeWrite.SourceContract = ELayoutFrozenTerrainCellContract::BridgeSpan;
		Contract.TerrainWrites.Add(BridgeWrite);

		FLayoutFrozenTerrainWriteRecord RampWrite;
		RampWrite.BlockWorldPos = FIntVector(64, 16, 16);
		RampWrite.SourceContract = ELayoutFrozenTerrainCellContract::Active;
		Contract.TerrainWrites.Add(RampWrite);

		FLayoutFrozenTerrainWriteRecord ExcavationWrite;
		ExcavationWrite.BlockWorldPos = FIntVector(80, 16, 16);
		ExcavationWrite.SourceContract = ELayoutFrozenTerrainCellContract::TunnelExcavation;
		Contract.TerrainWrites.Add(ExcavationWrite);
		return Contract;
	}
}

IMPLEMENT_SIMPLE_AUTOMATION_TEST(
	FLayoutRealizationWritePlanBuildsSiteBoundaryTest,
	"PorismExtension.Layout.Runtime.RealizationWritePlan.BuildsSiteBoundary",
	EAutomationTestFlags::EditorContext | EAutomationTestFlags::EngineFilter)

bool FLayoutRealizationWritePlanBuildsSiteBoundaryTest::RunTest(const FString& Parameters)
{
	const FLayoutSolveResult SolveResult = BuildSuccessfulWritePlanSolveResult();
	const FLayoutFrozenTerrainContract FrozenTerrainContract = BuildWritePlanFrozenTerrainContract();

	FLayoutRealizationWritePlan WritePlan;
	FString FailureReason;
	TestTrue(
		TEXT("Accepted site solve inputs build realization write plan"),
		LayoutRealizationWritePlan::TryBuildFromAcceptedSolveInputs(
			ELayoutRealizationWritePlanSource::Site,
			TEXT("SolvedArtifact.Site.0"),
			SolveResult.Placements.Num(),
			FrozenTerrainContract.ActiveCells.Num(),
			SolveResult,
			FrozenTerrainContract,
			WritePlan,
			FailureReason));
	TestFalse(TEXT("Write plan id is stable"), WritePlan.WritePlanId.IsNone());
	TestEqual(TEXT("Terrain write count copied"), WritePlan.TerrainWrites.TerrainWriteCount, 0, 0);
	TestEqual(TEXT("Excavation/clearance write count copied"), WritePlan.TerrainWrites.Excavation.Writes.Num(), 0, 0);
	TestEqual(TEXT("Foundation/ramp write count copied"), WritePlan.TerrainWrites.Support.FoundationRampWrites.Num(), 0, 0);
	TestEqual(TEXT("Bridge/support write count copied"), WritePlan.TerrainWrites.Support.BridgeSupportWrites.Num(), 0, 0);
	TestEqual(TEXT("Excavation write position copied"), WritePlan.TerrainWrites.Excavation.Writes[0].BlockWorldPos, FIntVector(32, 16, 8), 0, 0);
	TestEqual(TEXT("Excavation overlap bounds copied"), WritePlan.TerrainWrites.Excavation.OverlapBounds.Num(), 0, 0);
	TestEqual(TEXT("Clearance evidence cell copied"), WritePlan.TerrainWrites.Excavation.ClearanceCells.Num(), 0, 0);
	TestEqual(TEXT("Foundation fill evidence cell copied"), WritePlan.TerrainWrites.Support.FoundationFillCells.Num(), 0, 0);
	TestEqual(TEXT("Ramp transition evidence cell copied"), WritePlan.TerrainWrites.Support.RampTransitionCells.Num(), 0, 0);
	TestEqual(TEXT("Ramp transition cell copied"), WritePlan.TerrainWrites.Support.RampTransitionCells[0], FIntVector(3, 0, 0), 0, 0);
	TestEqual(TEXT("Bridge support evidence cell copied"), WritePlan.TerrainWrites.Support.BridgeSupportCells.Num(), 0, 0);
	TestEqual(TEXT("Bridge support cell copied"), WritePlan.TerrainWrites.Support.BridgeSupportCells[0], FIntVector(2, 0, 0), 0, 0);
	TestEqual(TEXT("Excavation overlap cell copied"), WritePlan.TerrainWrites.Excavation.OverlapBounds[0].Cell, FIntVector(4, 0, 0), 0, 0);
	TestEqual(TEXT("Excavation overlap min copied"), WritePlan.TerrainWrites.Excavation.OverlapBounds[0].OverlapMinLocalZ.Value, static_cast<uint8>(1), 0, 0);
	TestEqual(TEXT("Excavation overlap max copied"), WritePlan.TerrainWrites.Excavation.OverlapBounds[0].OverlapMaxLocalZ.Value, static_cast<uint8>(4), 0, 0);
	TestEqual(TEXT("Support write material copied"), WritePlan.TerrainWrites.Support.FoundationRampWrites[0].Material, 0, 0);
	TestEqual(TEXT("Template placement count copied"), WritePlan.TemplatePlacements.PlacementCount, 0, 0);
	TestEqual(TEXT("Chunk write batch terrain count copied"), WritePlan.ChunkWriteBatch.TerrainWriteCount, 0, 0);
	TestEqual(TEXT("Chunk write batch template count copied"), WritePlan.ChunkWriteBatch.TemplatePlacementCount, 0, 0);
	TestEqual(TEXT("Chunk write batch pass count copied"), WritePlan.ChunkWriteBatch.PassOrder.Num(), 0, 0);
	TestEqual(TEXT("Chunk write batch first pass is excavation"), static_cast<int32>(WritePlan.ChunkWriteBatch.PassOrder[0]), static_cast<int32>(ELayoutRealizationChunkWritePass::ExcavationClearance), 0, 0);
	TestEqual(TEXT("Chunk write batch second pass is support"), static_cast<int32>(WritePlan.ChunkWriteBatch.PassOrder[1]), static_cast<int32>(ELayoutRealizationChunkWritePass::FoundationRampBridgeSupport), 0, 0);
	TestEqual(TEXT("Chunk write batch final pass is template placement"), static_cast<int32>(WritePlan.ChunkWriteBatch.PassOrder[2]), static_cast<int32>(ELayoutRealizationChunkWritePass::TemplatePlacement), 0, 0);
	TestEqual(TEXT("Template placement entries copied"), WritePlan.TemplatePlacements.Entries.Num(), 0, 0);
	TestEqual(TEXT("Template placement snapshot id copied"), WritePlan.TemplatePlacements.Entries[0].ModuleSnapshotId, TEXT("Module.Snapshot.0"), 0, 0);
	TestEqual(TEXT("Template placement path copied"), WritePlan.TemplatePlacements.Entries[0].TemplatePath, FSoftObjectPath(TEXT("/Game/Test/Templates/T_Module.T_Module")), 0, 0);
	TestEqual(TEXT("Active-cell provenance copied"), WritePlan.ActiveCells.Num(), 0, 0);
	return true;
}

IMPLEMENT_SIMPLE_AUTOMATION_TEST(
	FLayoutRealizationWritePlanRejectsTerrainWritesWithoutCellContractsTest,
	"PorismExtension.Layout.Runtime.RealizationWritePlan.RejectsTerrainWritesWithoutCellContracts",
	EAutomationTestFlags::EditorContext | EAutomationTestFlags::EngineFilter)

bool FLayoutRealizationWritePlanRejectsTerrainWritesWithoutCellContractsTest::RunTest(const FString& Parameters)
{
	const FLayoutSolveResult SolveResult = BuildSuccessfulWritePlanSolveResult();
	FLayoutFrozenTerrainContract FrozenTerrainContract = BuildWritePlanFrozenTerrainContract();
	FrozenTerrainContract.CellContracts.Reset();

	FLayoutRealizationWritePlan WritePlan;
	FString FailureReason;
	TestFalse(
		TEXT("Write plan rejects terrain writes without cell-contract authority"),
		LayoutRealizationWritePlan::TryBuildFromAcceptedSolveInputs(
			ELayoutRealizationWritePlanSource::Connector,
			TEXT("SolvedArtifact.Connector.0"),
			SolveResult.Placements.Num(),
			FrozenTerrainContract.ActiveCells.Num(),
			SolveResult,
			FrozenTerrainContract,
			WritePlan,
			FailureReason));
	TestTrue(TEXT("Missing cell contract failure reported"), FailureReason.Contains(TEXT("terrain cell contracts")));
	return true;
}

IMPLEMENT_SIMPLE_AUTOMATION_TEST(
	FLayoutRealizationWritePlanRejectsMismatchedTerrainWriteAuthorityTest,
	"PorismExtension.Layout.Runtime.RealizationWritePlan.RejectsMismatchedTerrainWriteAuthority",
	EAutomationTestFlags::EditorContext | EAutomationTestFlags::EngineFilter)

bool FLayoutRealizationWritePlanRejectsMismatchedTerrainWriteAuthorityTest::RunTest(const FString& Parameters)
{
	const FLayoutSolveResult SolveResult = BuildSuccessfulWritePlanSolveResult();
	FLayoutFrozenTerrainContract FrozenTerrainContract = BuildWritePlanFrozenTerrainContract();
	FrozenTerrainContract.CellContracts.RemoveAll([](const FLayoutTerrainCellContractRecord& CellContract)
	{
		return CellContract.Contract == ELayoutFrozenTerrainCellContract::BridgeSpan;
	});

	FLayoutRealizationWritePlan WritePlan;
	FString FailureReason;
	TestFalse(
		TEXT("Write plan rejects terrain writes whose source contract lacks cell-contract authority"),
		LayoutRealizationWritePlan::TryBuildFromAcceptedSolveInputs(
			ELayoutRealizationWritePlanSource::Site,
			TEXT("SolvedArtifact.Site.1"),
			SolveResult.Placements.Num(),
			FrozenTerrainContract.ActiveCells.Num(),
			SolveResult,
			FrozenTerrainContract,
			WritePlan,
			FailureReason));
	TestTrue(TEXT("Mismatched cell-contract failure reported"), FailureReason.Contains(TEXT("matching cell-contract authority")));
	return true;
}

IMPLEMENT_SIMPLE_AUTOMATION_TEST(
	FLayoutRealizationWritePlanRejectsExcavationWritesWithoutOverlapBoundsTest,
	"PorismExtension.Layout.Runtime.RealizationWritePlan.RejectsExcavationWritesWithoutOverlapBounds",
	EAutomationTestFlags::EditorContext | EAutomationTestFlags::EngineFilter)

bool FLayoutRealizationWritePlanRejectsExcavationWritesWithoutOverlapBoundsTest::RunTest(const FString& Parameters)
{
	const FLayoutSolveResult SolveResult = BuildSuccessfulWritePlanSolveResult();
	FLayoutFrozenTerrainContract FrozenTerrainContract = BuildWritePlanFrozenTerrainContract();
	for (FLayoutTerrainCellContractRecord& CellContract : FrozenTerrainContract.CellContracts)
	{
		CellContract.bHasClearanceEvidence = false;
		CellContract.bHasExcavationOverlapZ = false;
		CellContract.ExcavationOverlapMinLocalZ = FLayoutLocalBlockCoord8();
		CellContract.ExcavationOverlapMaxLocalZ = FLayoutLocalBlockCoord8();
	}

	FLayoutRealizationWritePlan WritePlan;
	FString FailureReason;
	TestFalse(
		TEXT("Write plan rejects excavation writes when local overlap bounds were not preserved"),
		LayoutRealizationWritePlan::TryBuildFromAcceptedSolveInputs(
			ELayoutRealizationWritePlanSource::Site,
			TEXT("SolvedArtifact.Site.MissingOverlap"),
			SolveResult.Placements.Num(),
			FrozenTerrainContract.ActiveCells.Num(),
			SolveResult,
			FrozenTerrainContract,
			WritePlan,
			FailureReason));
	TestTrue(TEXT("Missing overlap bounds failure reported"), FailureReason.Contains(TEXT("local overlap bounds")));
	return true;
}

IMPLEMENT_SIMPLE_AUTOMATION_TEST(
	FLayoutRealizationWritePlanRejectsUnsupportedExcavationOverlapContractTest,
	"PorismExtension.Layout.Runtime.RealizationWritePlan.RejectsUnsupportedExcavationOverlapContract",
	EAutomationTestFlags::EditorContext | EAutomationTestFlags::EngineFilter)

bool FLayoutRealizationWritePlanRejectsUnsupportedExcavationOverlapContractTest::RunTest(const FString& Parameters)
{
	const FLayoutSolveResult SolveResult = BuildSuccessfulWritePlanSolveResult();
	FLayoutFrozenTerrainContract FrozenTerrainContract = BuildWritePlanFrozenTerrainContract();
	FrozenTerrainContract.CellContracts[0].bHasExcavationOverlapZ = true;
	LayoutLocalBlockCoordinates::TryMakeCoord8(0, FrozenTerrainContract.CellContracts[0].ExcavationOverlapMinLocalZ);
	LayoutLocalBlockCoordinates::TryMakeCoord8(2, FrozenTerrainContract.CellContracts[0].ExcavationOverlapMaxLocalZ);

	FLayoutRealizationWritePlan WritePlan;
	FString FailureReason;
	TestFalse(
		TEXT("Write plan rejects excavation overlap bounds on support-only cell contracts"),
		LayoutRealizationWritePlan::TryBuildFromAcceptedSolveInputs(
			ELayoutRealizationWritePlanSource::Site,
			TEXT("SolvedArtifact.Site.InvalidOverlap"),
			SolveResult.Placements.Num(),
			FrozenTerrainContract.ActiveCells.Num(),
			SolveResult,
			FrozenTerrainContract,
			WritePlan,
			FailureReason));
	TestTrue(TEXT("Unsupported overlap contract failure reported"), FailureReason.Contains(TEXT("excavation or clearance")));
	return true;
}

IMPLEMENT_SIMPLE_AUTOMATION_TEST(
	FLayoutRealizationWritePlanRejectsStaleTerrainReplayTest,
	"PorismExtension.Layout.Runtime.RealizationWritePlan.RejectsStaleTerrainReplay",
	EAutomationTestFlags::EditorContext | EAutomationTestFlags::EngineFilter)

bool FLayoutRealizationWritePlanRejectsStaleTerrainReplayTest::RunTest(const FString& Parameters)
{
	const FLayoutSolveResult SolveResult = BuildSuccessfulWritePlanSolveResult();
	FLayoutFrozenTerrainContract FrozenTerrainContract = BuildWritePlanFrozenTerrainContract();

	FLayoutRealizationWritePlan WritePlan;
	FString FailureReason;
	TestTrue(
		TEXT("Write plan builds before terrain replay validation"),
		LayoutRealizationWritePlan::TryBuildFromAcceptedSolveInputs(
			ELayoutRealizationWritePlanSource::Site,
			TEXT("SolvedArtifact.Site.TerrainReplay"),
			SolveResult.Placements.Num(),
			FrozenTerrainContract.ActiveCells.Num(),
			SolveResult,
			FrozenTerrainContract,
			WritePlan,
			FailureReason));

	FrozenTerrainContract.TerrainWrites[0].BlockWorldPos = FIntVector(64, 16, 16);
	TestFalse(
		TEXT("Write plan rejects terrain replay when terrain writes mutate after plan build"),
		LayoutRealizationWritePlan::ValidateTerrainWriteReplayForTests(
			WritePlan,
			FrozenTerrainContract,
			FailureReason));
	TestTrue(TEXT("Stale terrain replay failure reported"), FailureReason.Contains(TEXT("stale typed terrain subplan entries")));
	return true;
}

IMPLEMENT_SIMPLE_AUTOMATION_TEST(
	FLayoutRealizationWritePlanRejectsStaleRampTransitionEvidenceTest,
	"PorismExtension.Layout.Runtime.RealizationWritePlan.RejectsStaleRampTransitionEvidence",
	EAutomationTestFlags::EditorContext | EAutomationTestFlags::EngineFilter)

bool FLayoutRealizationWritePlanRejectsStaleRampTransitionEvidenceTest::RunTest(const FString& Parameters)
{
	const FLayoutSolveResult SolveResult = BuildSuccessfulWritePlanSolveResult();
	FLayoutFrozenTerrainContract FrozenTerrainContract = BuildWritePlanFrozenTerrainContract();

	FLayoutRealizationWritePlan WritePlan;
	FString FailureReason;
	TestTrue(
		TEXT("Write plan builds with explicit ramp-transition evidence"),
		LayoutRealizationWritePlan::TryBuildFromAcceptedSolveInputs(
			ELayoutRealizationWritePlanSource::Site,
			TEXT("SolvedArtifact.Site.RampTransitionReplay"),
			SolveResult.Placements.Num(),
			FrozenTerrainContract.ActiveCells.Num(),
			SolveResult,
			FrozenTerrainContract,
			WritePlan,
			FailureReason));
	TestEqual(TEXT("Ramp-transition evidence is preserved in support subplan"), WritePlan.TerrainWrites.Support.RampTransitionCells.Num(), 0, 0);

	for (FLayoutTerrainCellContractRecord& CellContract : FrozenTerrainContract.CellContracts)
	{
		if (CellContract.Cell == FIntVector(3, 0, 0))
		{
			CellContract.bHasRampTransitionEvidence = false;
			break;
		}
	}
	TestFalse(
		TEXT("Terrain replay rejects stale missing ramp-transition evidence"),
		LayoutRealizationWritePlan::ValidateTerrainWriteReplayForTests(
			WritePlan,
			FrozenTerrainContract,
			FailureReason));
	TestTrue(TEXT("Stale ramp-transition failure reported"), FailureReason.Contains(TEXT("stale typed terrain subplan entries")));
	return true;
}

IMPLEMENT_SIMPLE_AUTOMATION_TEST(
	FLayoutRealizationWritePlanRejectsMixedClearanceAndExcavationOverlapEvidenceTest,
	"PorismExtension.Layout.Runtime.RealizationWritePlan.RejectsMixedClearanceAndExcavationOverlapEvidence",
	EAutomationTestFlags::EditorContext | EAutomationTestFlags::EngineFilter)

bool FLayoutRealizationWritePlanRejectsMixedClearanceAndExcavationOverlapEvidenceTest::RunTest(const FString& Parameters)
{
	const FLayoutSolveResult SolveResult = BuildSuccessfulWritePlanSolveResult();
	FLayoutFrozenTerrainContract FrozenTerrainContract = BuildWritePlanFrozenTerrainContract();
	for (FLayoutTerrainCellContractRecord& CellContract : FrozenTerrainContract.CellContracts)
	{
		if (CellContract.Cell == FIntVector(1, 0, 0))
		{
			CellContract.bHasClearanceEvidence = true;
			CellContract.bHasExcavationOverlapZ = true;
			break;
		}
	}

	FLayoutRealizationWritePlan WritePlan;
	FString FailureReason;
	TestFalse(
		TEXT("Write plan rejects mixed clearance and excavation overlap evidence"),
		LayoutRealizationWritePlan::TryBuildFromAcceptedSolveInputs(
			ELayoutRealizationWritePlanSource::Site,
			TEXT("SolvedArtifact.Site.MixedClearanceExcavation"),
			SolveResult.Placements.Num(),
			FrozenTerrainContract.ActiveCells.Num(),
			SolveResult,
			FrozenTerrainContract,
			WritePlan,
			FailureReason));
	TestTrue(TEXT("Mixed clearance/excavation failure reported"), FailureReason.Contains(TEXT("mixed clearance and excavation overlap evidence")));
	return true;
}

IMPLEMENT_SIMPLE_AUTOMATION_TEST(
	FLayoutRealizationWritePlanRejectsStaleBridgeSupportEvidenceTest,
	"PorismExtension.Layout.Runtime.RealizationWritePlan.RejectsStaleBridgeSupportEvidence",
	EAutomationTestFlags::EditorContext | EAutomationTestFlags::EngineFilter)

bool FLayoutRealizationWritePlanRejectsStaleBridgeSupportEvidenceTest::RunTest(const FString& Parameters)
{
	const FLayoutSolveResult SolveResult = BuildSuccessfulWritePlanSolveResult();
	FLayoutFrozenTerrainContract FrozenTerrainContract = BuildWritePlanFrozenTerrainContract();

	FLayoutRealizationWritePlan WritePlan;
	FString FailureReason;
	TestTrue(
		TEXT("Write plan builds with explicit bridge-support evidence"),
		LayoutRealizationWritePlan::TryBuildFromAcceptedSolveInputs(
			ELayoutRealizationWritePlanSource::Site,
			TEXT("SolvedArtifact.Site.BridgeSupportReplay"),
			SolveResult.Placements.Num(),
			FrozenTerrainContract.ActiveCells.Num(),
			SolveResult,
			FrozenTerrainContract,
			WritePlan,
			FailureReason));
	TestEqual(TEXT("Bridge-support evidence is preserved in support subplan"), WritePlan.TerrainWrites.Support.BridgeSupportCells.Num(), 0, 0);

	for (FLayoutTerrainCellContractRecord& CellContract : FrozenTerrainContract.CellContracts)
	{
		if (CellContract.Cell == FIntVector(2, 0, 0))
		{
			CellContract.bHasBridgeSupportEvidence = false;
			break;
		}
	}
	TestFalse(
		TEXT("Terrain replay rejects stale missing bridge-support evidence"),
		LayoutRealizationWritePlan::ValidateTerrainWriteReplayForTests(
			WritePlan,
			FrozenTerrainContract,
			FailureReason));
	TestTrue(TEXT("Stale bridge-support failure reported"), FailureReason.Contains(TEXT("bridge support writes require bridge-support evidence")));
	return true;
}

