IMPLEMENT_SIMPLE_AUTOMATION_TEST(
	FLayoutRealizationWritePlanComputesStageMapAnchorsTest,
	"PorismExtension.Layout.Runtime.RealizationWritePlan.ComputesStageMapAnchorsForSteppedTerrain",
	EAutomationTestFlags::EditorContext | EAutomationTestFlags::EngineFilter)

bool FLayoutRealizationWritePlanComputesStageMapAnchorsTest::RunTest(const FString& Parameters)
{
	// Build a 2x2 solve result with placements at two XY columns that have different stage bases.
	FLayoutSolveResult SolveResult;
	SolveResult.bSucceeded = true;
	SolveResult.SharedCellSizeInBlocks = FIntVector(16, 16, 16);
	SolveResult.FootprintSize = FIntPoint(2);
	SolveResult.TemplatePlacementZOffsetBlocks = 0;

	FLayoutPlacedModule Placement0;
	Placement0.Cell = FIntVector(0, 0, 0);
	Placement0.SourceContentEntryId = TEXT("Entry.0");
	Placement0.ModuleSnapshotId = TEXT("Module.0");
	Placement0.TemplatePath = FSoftObjectPath(TEXT("/Game/T_0.T_0"));
	SolveResult.Placements.Add(Placement0);

	FLayoutPlacedModule Placement1;
	Placement1.Cell = FIntVector(1, 0, 0);  // Same authored Cell.Z=0, but at XY=(1,0)
	Placement1.SourceContentEntryId = TEXT("Entry.1");
	Placement1.ModuleSnapshotId = TEXT("Module.1");
	Placement1.TemplatePath = FSoftObjectPath(TEXT("/Game/T_1.T_1"));
	SolveResult.Placements.Add(Placement1);

	FLayoutFrozenTerrainContract FrozenTerrainContract;
	FrozenTerrainContract.ContractId = TEXT("Contract.Stepped");
	FrozenTerrainContract.SharedCellSizeInBlocks = FIntVector(16, 16, 16);
	FrozenTerrainContract.FootprintMinBlockWorldPos = FIntVector(100, 200, 200);
	FrozenTerrainContract.FootprintSizeInCells = FIntPoint(2);
	FrozenTerrainContract.ActiveCells = BuildWritePlanActiveCells();

	// Two XY columns with different stage bases: column (0,0) at Z=300, column (1,0) at Z=316
	FLayoutFrozenTerrainStageCellRecord Stage00;
	Stage00.FootprintCellXY = FIntPoint(0);
	Stage00.SnappedSupportFloorZ = 300;
	Stage00.VerticalShiftBlocks = 0;
	Stage00.TerrainStageIndex = 0;
	Stage00.ResolvedStageBaseBlockWorldZ = 300;
	Stage00.SourceEvidenceId = TEXT("Evidence.0.0");
	FrozenTerrainContract.StageMap.Add(Stage00);

	FLayoutFrozenTerrainStageCellRecord Stage10;
	Stage10.FootprintCellXY = FIntPoint(1);
	Stage10.SnappedSupportFloorZ = 316;
	Stage10.VerticalShiftBlocks = 16;
	Stage10.TerrainStageIndex = 2;
	Stage10.ResolvedStageBaseBlockWorldZ = 316;
	Stage10.SourceEvidenceId = TEXT("Evidence.1.0");
	FrozenTerrainContract.StageMap.Add(Stage10);

	FLayoutRealizationWritePlan WritePlan;
	FString FailureReason;
	TestTrue(
		TEXT("Write plan builds with stage map anchors"),
		LayoutRealizationWritePlan::TryBuildFromAcceptedSolveInputs(
			ELayoutRealizationWritePlanSource::Site,
			TEXT("SolvedArtifact.Stepped"),
			SolveResult.Placements.Num(),
			FrozenTerrainContract.ActiveCells.Num(),
			SolveResult,
			FrozenTerrainContract,
			WritePlan,
			FailureReason));

	TestEqual(TEXT("Two template entries built"), WritePlan.TemplatePlacements.Entries.Num(), 0, 0);

	// Column (0,0): anchor = FootprintMin(100,200) + Cell(0,0)*16 + StageBaseZ(300) + Cell.Z(0)*8 + Offset(0)
	const FIntVector ExpectedAnchor00(100, 200);
	const FIntVector& Anchor00 = WritePlan.TemplatePlacements.Entries[0].AcceptedAnchorBlockWorldPos;
	TestEqual(TEXT("Placement at (0,0,0) gets stage-base anchor Z=300"), Anchor00, ExpectedAnchor00, 0, 0);

	// Column (1,0): anchor = FootprintMin(100,200) + Cell(1,0)*16 + StageBaseZ(316) + Cell.Z(0)*8 + Offset(0)
	const FIntVector ExpectedAnchor10(116, 200);
	const FIntVector& Anchor10 = WritePlan.TemplatePlacements.Entries[1].AcceptedAnchorBlockWorldPos;
	TestEqual(TEXT("Placement at (1,0,0) gets different stage-base anchor Z=316"), Anchor10, ExpectedAnchor10, 0, 0);

	// Verify the two placements' anchor Z differs because their stage bases differ.
	TestNotEqual(TEXT("Two placements with different stage bases get different anchor Z"),
		Anchor00.Z, Anchor10.Z);

	return true;
}

IMPLEMENT_SIMPLE_AUTOMATION_TEST(
	FLayoutRealizationWritePlanPreservesTopLevelPlacementsTest,
	"PorismExtension.Layout.Runtime.RealizationWritePlan.PreservesTopLevelPlacementsAcrossStageColumns",
	EAutomationTestFlags::EditorContext | EAutomationTestFlags::EngineFilter)

bool FLayoutRealizationWritePlanPreservesTopLevelPlacementsTest::RunTest(const FString& Parameters)
{
	// Multi-level 2x1 layout: level-0 and level-1 placements at both columns.
	FLayoutSolveResult SolveResult;
	SolveResult.bSucceeded = true;
	SolveResult.SharedCellSizeInBlocks = FIntVector(16, 16, 16);
	SolveResult.FootprintSize = FIntPoint(2);
	SolveResult.TemplatePlacementZOffsetBlocks = 0;

	// Column (0,0) level-0 and level-1
	for (int32 Z = 0; Z < 2; ++Z)
	{
		FLayoutPlacedModule P;
		P.Cell = FIntVector(0, 0, Z);
		P.SourceContentEntryId = *FString::Printf(TEXT("Entry.%d.0"), Z);
		P.ModuleSnapshotId = *FString::Printf(TEXT("Module.%d.0"), Z);
		P.TemplatePath = FSoftObjectPath(TEXT("/Game/T.T"));
		SolveResult.Placements.Add(P);
	}
	// Column (1,0) level-0 and level-1
	for (int32 Z = 0; Z < 2; ++Z)
	{
		FLayoutPlacedModule P;
		P.Cell = FIntVector(1, 0, Z);
		P.SourceContentEntryId = *FString::Printf(TEXT("Entry.%d.1"), Z);
		P.ModuleSnapshotId = *FString::Printf(TEXT("Module.%d.1"), Z);
		P.TemplatePath = FSoftObjectPath(TEXT("/Game/T.T"));
		SolveResult.Placements.Add(P);
	}

	FLayoutFrozenTerrainContract FrozenTerrainContract;
	FrozenTerrainContract.ContractId = TEXT("Contract.TopLevel");
	FrozenTerrainContract.SharedCellSizeInBlocks = FIntVector(16, 16, 16);
	FrozenTerrainContract.FootprintMinBlockWorldPos = FIntVector(100, 200, 200);
	FrozenTerrainContract.FootprintSizeInCells = FIntPoint(2);
	FrozenTerrainContract.ActiveCells = BuildWritePlanActiveCells();

	// Column (0,0) at Z=300, column (1,0) at Z=316 (two stages apart)
	FLayoutFrozenTerrainStageCellRecord Stage00;
	Stage00.FootprintCellXY = FIntPoint(0);
	Stage00.SnappedSupportFloorZ = 300;
	Stage00.TerrainStageIndex = 0;
	Stage00.ResolvedStageBaseBlockWorldZ = 300;
	FrozenTerrainContract.StageMap.Add(Stage00);

	FLayoutFrozenTerrainStageCellRecord Stage10;
	Stage10.FootprintCellXY = FIntPoint(1);
	Stage10.SnappedSupportFloorZ = 316;
	Stage10.TerrainStageIndex = 2;
	Stage10.ResolvedStageBaseBlockWorldZ = 316;
	FrozenTerrainContract.StageMap.Add(Stage10);

	FLayoutRealizationWritePlan WritePlan;
	FString FailureReason;
	TestTrue(
		TEXT("Multi-level write plan builds with stage map"),
		LayoutRealizationWritePlan::TryBuildFromAcceptedSolveInputs(
			ELayoutRealizationWritePlanSource::Site,
			TEXT("SolvedArtifact.TopLevel"),
			SolveResult.Placements.Num(),
			FrozenTerrainContract.ActiveCells.Num(),
			SolveResult,
			FrozenTerrainContract,
			WritePlan,
			FailureReason));

	TestEqual(TEXT("Four template entries built"), WritePlan.TemplatePlacements.Entries.Num(), 0, 0);

	// Level-1 at column (0,0): baseZ=300 + Cell.Z=1 * 8 = 308
	TestEqual(TEXT("Top level at column (0,0) has anchor Z=308"),
		WritePlan.TemplatePlacements.Entries[1].AcceptedAnchorBlockWorldPos.Z);

	// Level-1 at column (1,0): baseZ=316 + Cell.Z=1 * 8 = 324
	TestEqual(TEXT("Top level at column (1,0) has anchor Z=324 (shifted by stage)"),
		WritePlan.TemplatePlacements.Entries[3].AcceptedAnchorBlockWorldPos.Z);

	return true;
}
